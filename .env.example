# Official worker specifiers and public RPC endpoints live in transportRegistry.ts.
# No private key, seed phrase, or secret belongs in frontend configuration.
# Optional public UI label. VITE_ variables are exposed in the browser bundle.
VITE_APP_ENV=development

# Optional local Sepolia demonstration. Development mode only; leave empty here.
# Replace each value in ignored .env.local with a public 0x address you control.
VITE_DEMO_OWNER=
VITE_DEMO_TOKEN=
VITE_DEMO_SPENDER=
